POSTGRES_DB=packrat
POSTGRES_USER=packrat
# openssl rand -base64 32
POSTGRES_PASSWORD=changeme
# openssl rand -base64 48 (base64, at least 256 bits)
JWT_SECRET=changeme
# invite links and CORS
PUBLIC_URL=https://packrat.TAILNET.ts.net
# first account (ADR-027, #36): delete ADMIN_PASSWORD after the first start
# ADMIN_PASSWORD: openssl rand -base64 24 (8-255 chars, same rules as register)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# rollback knob (ADR-026): latest or sha-<short sha>
BACKEND_TAG=latest
FRONTEND_TAG=latest
